+"use client";
+import { useEffect, useState } from "react";
+
+const PATH = "M30 190 C 140 30, 300 30, 410 120";
+
+export default function RouteMap() {
+  const [reduced, setReduced] = useState(false);
+  useEffect(() => {
+    setReduced(window.matchMedia("(prefers-reduced-motion: reduce)").matches);
+  }, []);
+
+  return (
+    <svg className="route" viewBox="0 0 440 240" role="img" aria-label="Ruta de vuelo desde Madrid">
+      <path className="path" d={PATH} />
+      <path className="trail" d={PATH} />
+      <circle cx="30" cy="190" r="5" fill="currentColor" />
+      <text x="30" y="215">Madrid</text>
+      <circle cx="410" cy="120" r="5" fill="none" stroke="currentColor" strokeWidth="2" />
+      <g className="plane" transform={reduced ? "translate(410 120) rotate(35)" : undefined}>
+        <path d="M0 -9 L5 6 L0 3 L-5 6 Z" transform="rotate(90)" />
+        {!reduced && (
+          <animateMotion dur="3.2s" begin=".3s" fill="freeze" rotate="auto" path={PATH} />
+        )}
+      </g>
+    </svg>
+  );
+}
diff --git a/app/portfolio.css b/app/portfolio.css
new file mode 100644
index 0000000..fbc8d72
--- /dev/null
+++ b/app/portfolio.css
@@ -0,0 +1,62 @@
+:root{
+  --paper:#eef2f4; --ink:#10202e; --muted:#4c5d6b; --line:#c4cfd6; --accent:#1a4fd6; --accent-ink:#fff;
+  --head:"Bricolage Grotesque","Trebuchet MS",sans-serif;
+  --body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
+}
+@media (prefers-color-scheme:dark){
+  :root{--paper:#0e1a24; --ink:#e8eef2; --muted:#9db0bd; --line:#2a3d4c; --accent:#7ea3ff; --accent-ink:#0e1a24;}
+}
+*{box-sizing:border-box}
+html{scroll-behavior:smooth}
+body{margin:0;background:var(--paper);color:var(--ink);font:400 1.0625rem/1.6 var(--body)}
+a{color:inherit}
+:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
+.wrap{max-width:62rem;margin:0 auto;padding:0 1.5rem}
+header.top{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0}
+.brand{font:700 1.1rem var(--head);text-decoration:none}
+nav a{margin-left:1.25rem;text-decoration:none;color:var(--muted)}
+nav a:hover{color:var(--ink)}
+.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:2rem;align-items:center;padding:4rem 0 5rem}
+h1{font:700 clamp(2.4rem,6vw,4.2rem)/1.04 var(--head);letter-spacing:-.02em;margin:0 0 1.25rem}
+.lead{max-width:34rem;color:var(--muted);margin:0 0 2rem}
+.btns{display:flex;flex-wrap:wrap;gap:.75rem}
+.btn{display:inline-block;padding:.7rem 1.2rem;border:2px solid var(--ink);border-radius:.4rem;text-decoration:none;font-weight:500}
+.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
+.btn:hover{transform:translateY(-1px)}
+.route{width:100%;height:auto;color:var(--ink)}
+.route .path{fill:none;stroke:var(--line);stroke-width:2;stroke-dasharray:6 7}
+.route .trail{fill:none;stroke:var(--accent);stroke-width:2.5;stroke-dasharray:600;stroke-dashoffset:600;animation:draw 3.2s ease-out .3s forwards}
+.route text{fill:var(--muted);font:500 13px var(--body)}
+.route .plane{fill:var(--accent)}
+@keyframes draw{to{stroke-dashoffset:0}}
+section{padding:3.5rem 0;border-top:1px solid var(--line)}
+h2{font:700 1.9rem/1.1 var(--head);letter-spacing:-.01em;margin:0 0 1.5rem}
+.about{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}
+.about p{margin:0 0 1rem;max-width:34rem}
+dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.25rem}
+dt{color:var(--muted)} dd{margin:0}
+.proj{display:grid;grid-template-columns:11rem 1fr;gap:1rem 2rem;padding:1.75rem 0;border-top:1px solid var(--line)}
+.proj:first-of-type{border-top:0;padding-top:0}
+.proj .meta{color:var(--muted);font-size:.95rem}
+.proj h3{font:700 1.35rem/1.2 var(--head);margin:0 0 .5rem}
+.proj p{margin:0 0 .85rem;max-width:40rem}
+.tags{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;margin:0;padding:0}
+.tags li{border:1px solid var(--line);border-radius:.3rem;padding:.1rem .55rem;font-size:.9rem}
+.proj a.link{font-weight:500}
+.job{padding:0 0 1.5rem}
+.job h3{font:700 1.2rem var(--head);margin:0}
+.job .when{color:var(--muted);margin:.15rem 0 .5rem}
+.job ul{margin:0;padding-left:1.2rem}
+.contact p{max-width:34rem}
+footer{padding:2rem 0 3rem;color:var(--muted);font-size:.95rem}
+@media (max-width:760px){
+  .hero,.about{grid-template-columns:1fr}
+  .hero{padding:2.5rem 0 3rem}
+  .proj{grid-template-columns:1fr;gap:.35rem}
+  nav a{margin-left:.9rem}
+}
+@media (prefers-reduced-motion:reduce){
+  html{scroll-behavior:auto}
+  .route .trail{animation:none;stroke-dashoffset:0}
+  .btn:hover{transform:none}
+}
